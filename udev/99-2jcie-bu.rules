# OMRON 2JCIE-BU01: bind ftdi_sio and expose as /dev/2jcie-bu
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0590", ATTRS{idProduct}=="00d4", RUN+="/sbin/modprobe ftdi_sio", RUN+="/bin/sh -c \"echo 0590 00d4 > /sys/bus/usb-serial/drivers/ftdi_sio/new_id\""
SUBSYSTEM=="tty", ATTRS{idVendor}=="0590", ATTRS{idProduct}=="00d4", SYMLINK+="2jcie-bu", GROUP="dialout", MODE="0660", TAG+="systemd"
